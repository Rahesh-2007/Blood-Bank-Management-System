# MongoDB Connection URI (Local MongoDB Compass or MongoDB Atlas Cloud)
# Default for local MongoDB Compass: mongodb://127.0.0.1:27017/
MONGO_URI=mongodb://127.0.0.1:27017/
DB_NAME=blood_bank_db

# Flask Application Settings
SECRET_KEY=super-secret-blood-bank-key-2026
FLASK_ENV=development
PORT=5000

# Default Super Admin Initial Credentials
ADMIN_EMAIL=admin@bloodbank.org
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin
